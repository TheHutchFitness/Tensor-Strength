# Tensor AI provider routing
AI_PRIMARY_PROVIDER=deepseek
AI_PRIMARY_MODEL=deepseek-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Heavy-reasoning escalation / provider fallback
AI_FALLBACK_MODEL=gpt-5.6-terra
OPENAI_API_KEY=
AI_ENABLE_FALLBACK=true
AI_FALLBACK_REASONING=medium

# Beta usage protection
AI_REQUESTS_PER_MINUTE=12
AI_REQUESTS_PER_DAY=80
AI_MAX_OUTPUT_TOKENS=1600

# Existing app values are also required:
# MONGO_URL=
# DB_NAME=
# JWT_SECRET=
